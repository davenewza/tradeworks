{
  "id": "get-supplier-price-list",
  "action_name": "getSupplierPriceList",
  "response": {
    "$.name": { "display_order": 0 },
    "$.supplierId": { "display_name": "Supplier", "display_order": 1 },
    "$.description": { "display_order": 1 },
    "$.currencyCode": { "display_name": "Currency", "display_order": 2 },
    "$.isActive": { "display_name": "Active", "display_order": 3 },
    "$.totalItems": { "display_name": "Items", "display_order": 4 },
    "$.priceListType": { "display_name": "Type", "display_order": 5 },
    "$.pricingScheme": { "display_name": "Pricing", "display_order": 6 },
    "$.zohoPriceListId": { "display_name": "Zoho price list ID", "display_order": 7 },
    "$.zohoModifiedAt": { "display_name": "Modified in Zoho", "display_order": 8 },
    "$.synchronisedAt": { "display_name": "Synced", "display_order": 9 }
  },
  "entry_activity_actions": [
    {
      "tool_id": "update-supplier-price-list-supplier",
      "title": "Link to supplier",
      "as_dialog": true,
      "emphasize": true,
      "display_order": 0
    }
  ],
  "embedded_tools": [
    {
      "id": "items",
      "title": "Items",
      "tools": [
        {
          "action_link": {
            "tool_id": "list-supplier-price-list-items"
          },
          "response_overrides": {
            "$.results[*].priceListId": false,
            "$.results[*].priceListName": false,
            "$.results[*].currencyCode": false,
            "$.results[*].isActive": false,
            "$.results[*].supplierName": false,
            "$.results[*].supplierLeadTimeInDays": false
          }
        }
      ]
    }
  ]
}
