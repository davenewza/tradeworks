{
  "id": "list-stock-and-cover",
  "action_name": "listStockAndCover",
  "name": "View stock and cover",
  "title": "Stock and cover",
  "icon": "emoji:📦",
  "help_text": "Every active product's stock on hand and months of cover at its current sales rate, graded against its supplier's lead time (blank until the product has a supplier). Filter by brand, supplier, SKU, name, ABC class, status or cover; click a column heading to sort by it. Figures refresh nightly — see docs/stock-cover.md.",
  "inputs": {
    "$.where.sku": {
      "display_name": "SKU"
    },
    "$.where.abcClass": {
      "display_name": "ABC class"
    },
    "$.where.stockCoverStatus": {
      "display_name": "Status"
    },
    "$.where.currentStockCover": {
      "display_name": "Current cover (months)"
    },
    "$.where.totalStockCover": {
      "display_name": "Total cover (months)"
    }
  },
  "response": {
    "$.results[*].sku": {
      "display_name": "SKU",
      "display_order": 1
    },
    "$.results[*].name": {
      "display_order": 2
    },
    "$.results[*].brandId": {
      "display_name": "Brand",
      "display_order": 3
    },
    "$.results[*].supplierId": {
      "display_name": "Supplier",
      "display_order": 4
    },
    "$.results[*].abcClass": {
      "display_name": "ABC class",
      "display_order": 5
    },
    "$.results[*].totalUnitsSold": {
      "display_name": "Total sales",
      "display_order": 6
    },
    "$.results[*].stockAvailable": {
      "display_name": "Stock available",
      "display_order": 7
    },
    "$.results[*].stockOnWay": {
      "display_name": "Stock on way",
      "display_order": 8
    },
    "$.results[*].estimatedMonthlySale": {
      "display_name": "Est. monthly sales",
      "display_order": 9
    },
    "$.results[*].currentStockCover": {
      "display_name": "Current cover",
      "display_order": 10
    },
    "$.results[*].totalStockCover": {
      "display_name": "Total cover",
      "display_order": 11
    },
    "$.results[*].stockCoverStatus": {
      "display_name": "Status",
      "display_order": 12
    },
    "$.results[*].id": {
      "display_order": 20,
      "link": {
        "tool_id": "get-product",
        "display_order": 0,
        "data_mapping": [
          {
            "key": "$.id",
            "path": {
              "path": "$.results[*].id"
            }
          }
        ]
      }
    },
    "$.results[*].views": {
      "visible": false
    },
    "$.results[*].sales": {
      "visible": false
    },
    "$.results[*].channelFees": {
      "visible": false
    },
    "$.results[*].costLines": {
      "visible": false
    },
    "$.results[*].prices": {
      "visible": false
    },
    "$.results[*].channelCodes": {
      "visible": false
    },
    "$.results[*].image": {
      "visible": false
    },
    "$.results[*].lengthInCm": {
      "visible": false
    },
    "$.results[*].widthInCm": {
      "visible": false
    },
    "$.results[*].heightInCm": {
      "visible": false
    },
    "$.results[*].weightInGrams": {
      "visible": false
    },
    "$.results[*].volumeInLitres": {
      "visible": false
    },
    "$.results[*].weightedUnitCost": {
      "visible": false
    },
    "$.results[*].weightedFreightIn": {
      "visible": false
    },
    "$.results[*].weightedLandedCost": {
      "visible": false
    },
    "$.results[*].totalSupplierBills": {
      "visible": false
    },
    "$.results[*].totalUnitsPurchased": {
      "visible": false
    },
    "$.results[*].totalSalesValue": {
      "visible": false
    },
    "$.results[*].averageSalePrice": {
      "visible": false
    },
    "$.results[*].synchronisedAt": {
      "visible": false
    },
    "$.results[*].stockSynchronisedAt": {
      "visible": false
    },
    "$.results[*].createdAt": {
      "visible": false
    },
    "$.results[*].updatedAt": {
      "visible": false
    },
    "$.results[*].isActive": {
      "visible": false
    },
    "$.results[*].supplierUnitCost": {
      "visible": false
    },
    "$.results[*].supplierCurrency": {
      "visible": false
    }
  },
  "pagination": {
    "page_size": {
      "default_value": 200
    }
  },
  "entry_activity_actions": [
    {
      "tool_id": "get-product",
      "title": "View product",
      "display_order": 0
    },
    {
      "tool_id": "update-product",
      "deleted": true
    },
    {
      "tool_id": "update-product-dimensions",
      "deleted": true
    }
  ],
  "filter_config": {
    "quick_search_field": "$.where.name.contains"
  }
}
