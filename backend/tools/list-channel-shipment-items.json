{
  "id": "list-channel-shipment-items",
  "action_name": "listChannelShipmentItems",
  "name": "Lines",
  "title": "Shipment lines",
  "response": {
    "$.results[*].sku": {
      "display_name": "SKU",
      "display_order": 1
    },
    "$.results[*].productName": {
      "display_name": "Product",
      "display_order": 2
    },
    "$.results[*].quantityRequired": {
      "display_name": "Required",
      "display_order": 3
    },
    "$.results[*].quantitySending": {
      "display_name": "Sending",
      "display_order": 4
    },
    "$.results[*].cancelled": {
      "display_name": "Cancelled",
      "display_order": 5
    },
    "$.results[*].listingRef": {
      "display_name": "Listing",
      "display_order": 6
    },
    "$.results[*].productId": {
      "display_order": 7,
      "link": {
        "tool_id": "get-product",
        "display_order": 0,
        "data_mapping": [
          {
            "key": "$.id",
            "path": {
              "path": "$.results[*].productId"
            }
          }
        ]
      }
    },
    "$.results[*].externalId": {
      "visible": false
    },
    "$.results[*].shipmentId": {
      "visible": false
    },
    "$.results[*].createdAt": {
      "visible": false
    },
    "$.results[*].updatedAt": {
      "visible": false
    }
  }
}
