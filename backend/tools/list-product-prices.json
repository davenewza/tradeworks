  "get_entry_action": {
    "tool_id": "get-product-price",
    "deleted": true
  },
  "create_entry_action": {
    "tool_id": "create-product-price",
    "as_dialog": true
  },
  "display_layout": {
    "config": {
      "type": 3
    }
  }
}