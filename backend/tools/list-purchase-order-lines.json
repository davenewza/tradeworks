{
  "id": "list-purchase-order-lines",
  "action_name": "listPurchaseOrderLines",
  "name": "Purchase order lines",
  "title": "Purchase order lines",
  "help_text": "Every line of every purchase order, from Zoho. On way is what is still to arrive: ordered, less received and cancelled — 0 on a draft or cancelled order. Billing doesn't change it: an import billed before it lands is still on the way.",
