{
  "id": "list-product-stock",
  "action_name": "listProducts",
  "name": "Stock & cover",
  "icon": "emoji:📦",
  "inputs": {
    "$.where.brand": { "visible": false },
    "$.where.brand.id": { "visible": false },
    "$.where.brand.id.equals": { "visible": false },
    "$.where.brand.id.notEquals": { "visible": false },
    "$.where.brand.id.oneOf": { "visible": false }
  },
  "response": {
    "$.results[*].sku": {
      "display_name": "SKU",
      "display_order": 1
    },
    "$.results[*].name": {
      "display_order": 2
    },
    "$.results[*].totalUnitsSold": {
      "display_name": "Total sales",
      "display_order": 3
    },
    "$.results[*].stockAvailable": {
      "display_name": "Stock available",
      "display_order": 4
    },
    "$.results[*].stockOnWay": {
      "display_name": "Stock on way",
      "display_order": 5
    },
    "$.results[*].estimatedMonthlySale": {
      "display_name": "Est. monthly sales",
      "display_order": 6
    },
    "$.results[*].currentStockCover": {
      "display_name": "Current cover",
      "display_order": 7
    },
    "$.results[*].totalStockCover": {
      "display_name": "Total cover",
      "display_order": 8
    },
    "$.results[*].id": {
      "display_order": 20,
      "link": {
        "tool_id": "get-product",
        "display_order": 0,
        "data_mapping": [
          {
            "key": "$.id",
            "path": {
              "path": "$.results[*].id"
            }
          }
        ]
      }
    },
    "$.results[*].brandId": { "display_order": 30, "visible": false },
    "$.results[*].views": { "visible": false },
    "$.results[*].sales": { "visible": false },
    "$.results[*].channelFees": { "visible": false },
    "$.results[*].costLines": { "visible": false },
    "$.results[*].prices": { "visible": false },
    "$.results[*].image": { "visible": false },
    "$.results[*].isEnabled": { "visible": false },
    "$.results[*].lengthInCm": { "visible": false },
    "$.results[*].widthInCm": { "visible": false },
    "$.results[*].heightInCm": { "visible": false },
    "$.results[*].weightInGrams": { "visible": false },
    "$.results[*].volumeInLitres": { "visible": false },
    "$.results[*].weightedUnitCost": { "visible": false },
    "$.results[*].weightedFreightIn": { "visible": false },
    "$.results[*].weightedLandedCost": { "visible": false },
    "$.results[*].totalSupplierBills": { "visible": false },
    "$.results[*].totalUnitsPurchased": { "visible": false },
    "$.results[*].totalSalesValue": { "visible": false },
    "$.results[*].averageSalePrice": { "visible": false },
    "$.results[*].synchronisedAt": { "visible": false },
    "$.results[*].stockSynchronisedAt": { "visible": false },
    "$.results[*].createdAt": { "visible": false },
    "$.results[*].updatedAt": { "visible": false }
  },
  "pagination": {
    "page_size": {
      "default_value": 200
    }
  },
  "entry_activity_actions": [
    { "tool_id": "get-product", "title": "View product", "display_order": 0 },
    { "tool_id": "update-product", "deleted": true },
    { "tool_id": "update-product-dimensions", "deleted": true },
    { "tool_id": "disable-product", "deleted": true }
  ],
  "filter_config": {
    "quick_search_field": "$.where.name.contains"
  }
}
