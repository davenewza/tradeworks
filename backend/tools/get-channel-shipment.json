      "display_order": 0,
      "tools": [
        {
          "action_link": {
            "tool_id": "list-channel-shipment-items",
            "title": "Lines",
            "data_mapping": [
              {
                "key": "$.where.shipment.id.equals",
                "path": {
                  "path": "$.id"
                }
              }
            ]
          },
          "response_overrides": {
            "$.results[*].shipmentId": false
          }
