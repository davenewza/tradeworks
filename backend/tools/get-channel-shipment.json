    "$.destination": {
      "display_name": "Destination",
      "display_order": 6
    },
    "$.dueDate": {
      "display_name": "Due",
      "display_order": 7
    },
    "$.placedAt": {
      "display_name": "Placed",
      "display_order": 8
    },
    "$.receivedAt": {
      "display_name": "Received",
      "display_order": 9
