{
  "id": "get-supplier",
  "action_name": "getSupplier",
  "response": {
    "$.products": {
      "link": {
        "tool_id": "list-products",
        "data_mapping": [
          {
            "key": "$.where.supplier.id.equals",
            "path": {
              "path": "$.id"
            }
          }
        ]
      }
    },
    "$.totalProducts": {
      "display_name": "Active products"
    }
  },
  "entry_activity_actions": [
    {
      "tool_id": "plan-purchase",
      "title": "Plan a purchase",
      "data_mapping": [
        {
          "key": "$.supplierId",
          "path": {
            "path": "$.id"
          }
        }
      ],
      "emphasize": true,
      "display_order": 0
    },
    {
      "tool_id": "list-stock-and-cover",
      "title": "View stock & cover",
      "data_mapping": [
        {
          "key": "$.where.supplier.id.equals",
          "path": {
            "path": "$.id"
          }
        }
      ],
      "display_order": 1
    },
    {
      "tool_id": "update-supplier",
      "title": "Edit supplier",
      "as_dialog": true,
      "display_order": 2
    },
    {
      "tool_id": "delete-supplier",
      "display_order": 3
    }
  ],
  "embedded_tools": [
    {
      "id": "products",
      "tools": [
        {
          "action_link": {
            "tool_id": "list-products"
          },
          "response_overrides": {
            "$.results[*].supplierId": false
          }
        }
      ]
    }
  ]
}
