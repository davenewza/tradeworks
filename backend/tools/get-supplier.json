{
  "id": "get-supplier",
  "action_name": "getSupplier",
  "response": {
    "$.zohoVendorId": {
      "display_name": "Zoho vendor ID"
    },
    "$.totalPriceLists": {
      "display_name": "Price lists"
    }
  },
  "entry_activity_actions": [
    {
      "tool_id": "plan-purchase",
      "title": "Plan a purchase",
      "data_mapping": [
        {
          "key": "$.supplierId",
          "path": {
            "path": "$.id"
          }
        }
      ],
      "emphasize": true,
      "display_order": 0
    },
    {
      "tool_id": "list-stock-and-cover",
      "title": "View stock & cover",
      "data_mapping": [
        {
          "key": "$.where.supplierPrices.priceList.supplier.id.equals",
          "path": {
            "path": "$.id"
          }
        }
      ],
      "display_order": 1
    },
    {
      "tool_id": "list-products",
      "title": "View products",
      "data_mapping": [
        {
          "key": "$.where.supplierPrices.priceList.supplier.id.equals",
          "path": {
            "path": "$.id"
          }
        }
      ],
      "display_order": 2
    },
    {
      "tool_id": "update-supplier",
      "title": "Edit supplier",
      "as_dialog": true,
      "display_order": 3
    },
    {
      "tool_id": "delete-supplier",
      "display_order": 4
    }
  ],
  "embedded_tools": [
    {
      "id": "priceLists",
      "title": "Price lists",
      "tools": [
        {
          "action_link": {
            "tool_id": "list-supplier-price-lists"
          },
          "response_overrides": {
            "$.results[*].supplierId": false
          }
        }
      ]
    },
    {
      "id": "bills",
      "title": "Bills",
      "tools": [
        {
          "action_link": {
            "tool_id": "list-supplier-bills"
          },
          "response_overrides": {
            "$.results[*].supplierId": false
          }
        }
      ]
    },
    {
      "id": "purchaseOrders",
      "title": "Purchase orders",
      "tools": [
        {
          "action_link": {
            "tool_id": "list-purchase-orders"
          },
          "response_overrides": {
            "$.results[*].vendorName": false
          }
        }
      ]
    }
  ]
}
