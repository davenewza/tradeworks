{
  "id": "list-products",
  "action_name": "listProducts",
  "icon": "emoji:🤖",
  "inputs": {
    "$.where.sku": {
      "display_name": "SKU"
    },
    "$.where.abcClass": {
      "display_name": "ABC class"
    }
  },
  "response": {
    "$.results[*].sku": {
      "display_order": 1,
      "display_name": "SKU"
    },
    "$.results[*].name": {
      "display_order": 2
    },
    "$.results[*].brandId": {
      "display_order": 3,
      "display_name": "Brand"
    },
    "$.results[*].id": {
      "display_order": 12,
      "link": {
        "tool_id": "get-product",
        "display_order": 0,
        "data_mapping": [
          {
            "key": "$.id",
            "path": {
              "path": "$.results[*].id"
            }
          }
        ]
      }
    },
    "$.results[*].image": {
      "visible": false
    },
    "$.results[*].lengthInCm": {
      "visible": false
    },
    "$.results[*].widthInCm": {
      "visible": false
    },
    "$.results[*].heightInCm": {
      "visible": false
    },
    "$.results[*].weightInGrams": {
      "visible": false
    },
    "$.results[*].volumeInLitres": {
      "visible": false
    },
    "$.results[*].weightedUnitCost": {
      "visible": false
    },
    "$.results[*].weightedFreightIn": {
      "visible": false
    },
    "$.results[*].weightedLandedCost": {
      "visible": false
    },
    "$.results[*].totalSupplierBills": {
      "visible": false
    },
    "$.results[*].totalUnitsPurchased": {
      "visible": false
    },
    "$.results[*].totalUnitsSold": {
      "visible": false
    },
    "$.results[*].totalSalesValue": {
      "visible": false
    },
    "$.results[*].averageSalePrice": {
      "visible": false
    },
    "$.results[*].abcClass": {
      "display_name": "ABC class",
      "display_order": 4
    },
    "$.results[*].stockAvailable": {
      "visible": false
    },
    "$.results[*].stockOnWay": {
      "visible": false
    },
    "$.results[*].estimatedMonthlySale": {
      "visible": false
    },
    "$.results[*].currentStockCover": {
      "visible": false
    },
    "$.results[*].totalStockCover": {
      "visible": false
    },
    "$.results[*].stockSynchronisedAt": {
      "visible": false
    },
    "$.results[*].synchronisedAt": {
      "visible": false
    },
    "$.results[*].views": {
      "visible": false
    },
    "$.results[*].sales": {
      "visible": false
    },
    "$.results[*].channelFees": {
      "visible": false
    },
    "$.results[*].costLines": {
      "visible": false
    },
    "$.results[*].prices": {
      "visible": false
    },
    "$.results[*].createdAt": {
      "visible": false
    },
    "$.results[*].updatedAt": {
      "visible": false
    },
    "$.results[*].isActive": {
      "visible": false
    }
  },
  "entry_activity_actions": [
    {
      "tool_id": "get-product",
      "title": "View product",
      "display_order": 0
    },
    {
      "tool_id": "update-product",
      "display_order": 2
    },
    {
      "tool_id": "update-product-dimensions",
      "display_order": 3
    }
  ]
}
