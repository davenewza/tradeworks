{
  "id": "update-channel-label-element",
  "action_name": "updateChannelLabelElement",
  "name": "Edit label element",
  "title": "Edit this line of the label",
  "help_text": "Position orders the elements down the label; stacked text ignores it and sits beside the bars. Text applies to Text and Stacked text, max lines to Title, max bar height to Barcode. An empty font size means the size the layout derives from the label height; a size set here is never shrunk to make room, so the barcode gives way instead.",
  "inputs": {
    "$.where.id": {
      "display_name": "Element",
      "display_order": 1
    },
    "$.values.position": {
      "display_name": "Position",
      "display_order": 2
    },
    "$.values.kind": {
      "display_name": "Element",
      "display_order": 3
    },
    "$.values.text": {
      "display_name": "Text",
      "display_order": 4
    },
    "$.values.maxLines": {
      "display_name": "Max lines (title only)",
      "display_order": 5
    },
    "$.values.maxHeightMm": {
      "display_name": "Max bar height mm (barcode only)",
      "display_order": 6
    },
    "$.values.fontSizeMm": {
      "display_name": "Font size mm",
      "display_order": 7
    },
    "$.values.paddingMm": {
      "display_name": "Padding below mm",
      "display_order": 8
    },
    "$.values.align": {
      "display_name": "Alignment",
      "display_order": 9
    }
  }
}
