{
  "id": "list-channel-label-specs",
  "action_name": "listChannelLabelSpecs",
  "name": "Label specs",
  "icon": "emoji:🏷️",
  "help_text": "One row per channel we print unit labels for. The symbology decides what the code may be: EAN-13 takes 13 digits (Takealot prints the product's GTIN); Code 128 takes any printable text (Amazon prints the FNSKU). The annotation is fixed text on every label for that channel — Takealot's \"MP\", or the item condition Amazon requires.",
  "response": {
    "$.results[*].channelId": { "display_name": "Channel", "display_order": 1 },
    "$.results[*].symbology": { "display_name": "Symbology", "display_order": 2 },
    "$.results[*].annotation": { "display_name": "Annotation", "display_order": 3 },
    "$.results[*].annotationPlacement": { "display_name": "Placement", "display_order": 4 },
    "$.results[*].defaultStock": { "display_name": "Label stock", "display_order": 5 },
    "$.results[*].isEnabled": { "display_name": "Enabled", "display_order": 6 },
    "$.results[*].createdAt": { "visible": false },
    "$.results[*].updatedAt": { "visible": false },
    "$.results[*].id": {
      "display_order": 10,
      "link": {
        "tool_id": "get-channel-label-spec",
        "display_order": 0,
        "data_mapping": [{ "key": "$.id", "path": { "path": "$.results[*].id" } }]
      }
    }
  }
}
