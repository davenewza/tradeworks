{
  "id": "get-supplier-bill",
  "action_name": "getSupplierBill",
  "response": {
    "$.billNumber": { "display_name": "Bill number", "display_order": 0 },
    "$.supplierId": { "display_name": "Supplier", "display_order": 1 },
    "$.date": { "display_order": 2 },
    "$.status": { "display_order": 3 },
    "$.currencyCode": { "display_name": "Currency", "display_order": 4 },
    "$.total": { "display_name": "Total incl VAT", "display_order": 5 },
    "$.zohoBillId": { "display_name": "Zoho bill ID", "display_order": 6 },
    "$.zohoModifiedAt": { "display_name": "Modified in Zoho", "display_order": 7 },
    "$.synchronisedAt": { "display_name": "Synced", "display_order": 8 },
    "$.supplierName": { "visible": false }
  },
  "embedded_tools": [
    {
      "id": "lines",
      "title": "Lines",
      "tools": [
        {
          "action_link": {
            "tool_id": "list-supplier-bill-lines"
          },
          "response_overrides": {
            "$.results[*].supplierBillId": false,
            "$.results[*].billDate": false
          }
        }
      ]
    }
  ]
}
