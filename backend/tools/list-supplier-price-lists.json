{
  "id": "list-supplier-price-lists",
  "action_name": "listSupplierPriceLists",
  "name": "Supplier price lists",
  "title": "Supplier price lists",
  "icon": "emoji:🏷️",
  "help_text": "Every purchase price list in Zoho, mirrored nightly by Sync supplier price lists. Prices are read-only here: change them in Zoho, then sync. Zoho doesn't say whose prices a list holds, so link each new list to its supplier with Link to supplier: a supplier's purchase plans price from its own lists. A product's page shows its price on every list. See docs/supplier-price-lists.md.",
  "response": {
    "$.results[*].name": { "display_order": 0 },
    "$.results[*].supplierId": { "display_name": "Supplier", "display_order": 1 },
    "$.results[*].currencyCode": { "display_name": "Currency", "display_order": 1 },
    "$.results[*].totalItems": { "display_name": "Items", "display_order": 2 },
    "$.results[*].isActive": { "display_name": "Active", "display_order": 3 },
    "$.results[*].pricingScheme": { "display_name": "Pricing", "display_order": 4 },
    "$.results[*].zohoModifiedAt": { "display_name": "Modified in Zoho", "display_order": 5 },
    "$.results[*].synchronisedAt": { "display_name": "Synced", "display_order": 6 },
    "$.results[*].description": { "visible": false },
    "$.results[*].priceListType": { "visible": false },
    "$.results[*].zohoPriceListId": { "display_name": "Zoho price list ID", "visible": false },
    "$.results[*].createdAt": { "visible": false },
    "$.results[*].updatedAt": { "visible": false },
    "$.results[*].id": {
      "display_order": 20,
      "link": {
        "tool_id": "get-supplier-price-list",
        "display_order": 0,
        "data_mapping": [{ "key": "$.id", "path": { "path": "$.results[*].id" } }]
      }
    }
  },
  "inputs": {
    "$.where.supplier.id": { "display_name": "Supplier" }
  },
  "entry_activity_actions": [
    {
      "tool_id": "get-supplier-price-list",
      "title": "View price list",
      "display_order": 0
    },
    {
      "tool_id": "update-supplier-price-list-supplier",
      "title": "Link to supplier",
      "as_dialog": true,
      "display_order": 1
    }
  ]
}
