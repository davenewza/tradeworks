{
  "id": "list-team-tasks-overdue",
  "action_name": "listTeamTasksOverdue",
  "name": "Overdue tasks",
  "icon": "emoji:\ud83d\udccb",
  "response": {
    "$.pageInfo": {
      "visible": true
    },
    "$.pageInfo.count": {
      "visible": true
    },
    "$.pageInfo.endCursor": {
      "visible": true
    },
    "$.pageInfo.hasNextPage": {
      "visible": true
    },
    "$.pageInfo.pageNumber": {
      "visible": true
    },
    "$.pageInfo.startCursor": {
      "visible": true
    },
    "$.pageInfo.totalCount": {
      "visible": true
    },
    "$.results[*].completedAt": {
      "visible": false
    },
    "$.results[*].createdAt": {
      "visible": false
    },
    "$.results[*].createdById": {
      "visible": false
    },
    "$.results[*].description": {
      "visible": false
    },
    "$.results[*].id": {
      "link": {
        "tool_id": "get-team-task",
        "display_order": 0,
        "data_mapping": [
          {
            "key": "$.id",
            "path": {
              "path": "$.results[*].id"
            }
          }
        ]
      }
    },
    "$.results[*].status": {
      "format": {
        "enum_config": {
          "values": [
            {
              "value": "Backlog",
              "display_value": "Backlog",
              "colour": "grey",
              "display_order": 1
            },
            {
              "value": "InProgress",
              "display_value": "In progress",
              "colour": "sunshine",
              "display_order": 3
            },
            {
              "value": "Waiting",
              "display_value": "Waiting",
              "colour": "red",
              "display_order": 4
            },
            {
              "value": "Done",
              "display_value": "Done",
              "colour": "green",
              "display_order": 5
            },
            {
              "value": "Archived",
              "display_value": "Archived",
              "colour": "pale",
              "display_order": 6
            }
          ]
        }
      }
    },
    "$.results[*].updatedAt": {
      "visible": false
    }
  },
  "pagination": {
    "page_size": {
      "default_value": 200
    }
  },
  "display_layout": {
    "config": {
      "board_config": {
        "group_by_field": {
          "path": "$.results[*].status"
        }
      },
      "type": 3
    }
  },
  "entry_activity_actions": [
    {
      "tool_id": "edit-team-task-inline",
      "deleted": true
    },
    {
      "tool_id": "move-team-task",
      "display_order": 1
    },
    {
      "tool_id": "assign-team-task",
      "display_order": 2
    },
    {
      "tool_id": "update-team-task",
      "display_order": 3
    },
    {
      "tool_id": "archive-team-task",
      "display_order": 4
    },
    {
      "tool_id": "delete-team-task",
      "display_order": 5
    }
  ],
  "inputs": {
    "$.where.assignee.id.equals": {
      "lookup_action": {
        "tool_id": "list-warehouse-users",
        "as_dialog": true
      }
    },
    "$.where.assignee.id.oneOf": {
      "lookup_action": {
        "tool_id": "list-warehouse-users",
        "as_dialog": true
      }
    },
    "$.where.assignee.id.notEquals": {
      "lookup_action": {
        "tool_id": "list-warehouse-users",
        "as_dialog": true
      }
    }
  }
}
