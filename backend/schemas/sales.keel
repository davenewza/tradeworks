model Sale {
    fields {
        invoiceNumber Text
        lineItemId Text
        // Stable per-line identity from the source order (Takealot orderItemId,
        // Amazon OrderItemId, Shopify line id), carried on the Zoho line. Null for
        // invoices not managed by a channel integration.
        orderItemId Text?
        // Dedup identity: orderItemId when present (stable across Zoho re-saves),
        // else the Zoho line_item_id. line_item_id alone is NOT stable — Zoho
        // regenerates it on every invoice re-save, which was duplicating sales.
        // Required: it's half of @unique below, and a null would escape that
        // constraint (Postgres treats NULLs as distinct). Always set on write.
        lineKey Text
        channel Channel
        date Date
        product Product
        quantity Number
        price Decimal
        // Realized line figures from Zoho, net of any discount. These supersede
        // the derived total/vat below for revenue and margin analysis (which use
        // the list price and can't see discounts).
        netAmount Decimal?
        // item_total — line total excl VAT, after discount
        // Zoho exposes no per-line tax amount (only tax_percentage), and VAT is a
        // uniform 15% here, so derive it from the net amount.
        taxAmount Decimal? @computed(sale.netAmount * 0.15)
        discountAmount Decimal?
        // discount_amount — line discount (excl VAT)
        invoiceStatus Text?
        // invoice status (e.g. paid, draft, overdue)
        onPromotion Boolean?
        // invoice "On Promotion" custom field
        total Decimal @computed(sale.price * sale.quantity)
        vat Decimal @computed(sale.total * 0.15)
        totalExclVat Decimal @computed(sale.total - sale.vat)
        synchronisedAt Timestamp?
    }

    actions {
        list listSales(date?, product.id?, channel.id?)
        write handleInvoiceWebhook(Any) returns (Any) {
            @permission(expression: true)
        }
    }

    @unique([invoiceNumber, lineKey])

    @permission(
        roles: [Operator],
        actions: [get, list]
    )
}

flow SyncSales {
    inputs {
        start Date
        end Date
    }
    @permission(expression: ctx.isAuthenticated)
}

flow ScheduledSyncSales {
    @schedule("every 6 hours")
    @permission(expression: true)
}

team Warehouse {
    roles {
        Operator
    }
 }

role Operator { }