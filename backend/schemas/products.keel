model Brand {
    fields {
        name Text
        logo File?
        products Product[]
        totalProducts Number @computed(COUNTIF(brand.products, brand.products.isEnabled))
        // How long (in days) new stock takes to arrive from this brand's
        // supplier — used to grade each product's stock-cover status. Editable on
        // the brand page; hidden from the brands list.
        leadTimeInDays Number @default(60)
    }

    actions {
        get getBrand(id)
        list listBrands()
        update updateBrandName(id) with (name)
        update updateBrandLogo(id) with (logo)
        update updateBrandLeadTime(id) with (leadTimeInDays)
    }

    @permission(
        roles: [Operator],
        actions: [get, list, update, delete]
    )
}

enum StockCoverStatus {
    GoodSupply
    LowSupply
    InsufficientSupply
    Oversupply
}

model Product {
    fields {
        name Text
        brand Brand
        sku Text @unique
        image File?
        lengthInCm Decimal?
        widthInCm Decimal?
        heightInCm Decimal?
        weightInGrams Decimal?
        volumeInLitres Decimal? @computed(product.lengthInCm * product.widthInCm * product.heightInCm / 1000)
        isEnabled Boolean @default(true)
        synchronisedAt Timestamp?
        views ProductViews[]
        sales Sale[]
        channelFees ProductChannelFee[]
        costLines ProductCostLine[]
        prices ProductPrice[]
        channelCodes ProductChannelCode[]
        // Weighted-average cost of goods and freight-in across the product's
        // supplier bills, weighted by units received. SUM is COALESCE'd to 0, so
        // the IF guards the no-cost-lines 0/0 case.
        weightedUnitCost Decimal? @computed(IF(SUM(product.costLines.quantity) > 0, SUM(product.costLines.extendedUnitCost) / SUM(product.costLines.quantity), SUM(product.costLines.extendedUnitCost) * 0))
        weightedFreightIn Decimal? @computed(IF(SUM(product.costLines.quantity) > 0, SUM(product.costLines.extendedFreightIn) / SUM(product.costLines.quantity), SUM(product.costLines.extendedFreightIn) * 0))
        weightedLandedCost Decimal? @computed(product.weightedUnitCost + product.weightedFreightIn)
        // Purchase history summary across the product's supplier bills.
        totalSupplierBills Number? @computed(COUNT(product.costLines.id))
        totalUnitsPurchased Decimal? @computed(SUM(product.costLines.quantity))
        // Sales history summary across the product's synced sales. Revenue and
        // average price use the realized net amount (excl VAT, after discount),
        // so promotions/discounts are reflected — not the list price.
        totalUnitsSold Number? @computed(SUM(product.sales.quantity))
        totalSalesValue Decimal? @computed(SUM(product.sales.netAmount))
        averageSalePrice Decimal? @computed(IF(SUM(product.sales.quantity) > 0, SUM(product.sales.netAmount) / SUM(product.sales.quantity), SUM(product.sales.netAmount) * 0))
        // ─── Stock & cover ──────────────────────────────────────────────────
        // Refreshed daily by ScheduledSyncStock. stockAvailable mirrors Zoho's
        // stock_on_hand (physical units on hand; can be negative when sales are
        // billed ahead of stock). stockOnWay is units on future-dated supplier
        // bills — Phase 2, so it stays 0 until that sync lands.
        stockAvailable Number?
        stockOnWay Number @default(0)
        // Trailing run-rate, rounded to a whole number: units sold in the last
        // 365 days ÷ months active (capped at 12). Written by the daily job.
        estimatedMonthlySale Decimal?
        stockSynchronisedAt Timestamp?
        // Months of cover = stock ÷ (whole-number) estimate, rounded to 1 dp and
        // written by the daily job. Null when the estimate is 0/unknown (shown
        // blank, like the sheet). Not @computed — the engine can't round, and
        // cover must stay consistent with the rounded estimate it's shown beside.
        currentStockCover Decimal?
        totalStockCover Decimal?
        // Reorder signal: current cover vs the brand's lead time (L = days / 30):
        //   Shortfall (<L) · Low (L–1.25L) · Good (1.25L–2L) · Oversupply (≥2L).
        // Null when cover is unknown. @computed, so it re-grades the moment cover
        // or the brand's lead time changes.
        stockCoverStatus StockCoverStatus? @computed(IF(product.currentStockCover == null, null, IF(product.currentStockCover < product.brand.leadTimeInDays / 30, StockCoverStatus.InsufficientSupply, IF(product.currentStockCover < product.brand.leadTimeInDays / 30 * 1.25, StockCoverStatus.LowSupply, IF(product.currentStockCover < product.brand.leadTimeInDays / 30 * 2, StockCoverStatus.GoodSupply, StockCoverStatus.Oversupply)))))
    }

    actions {
        get getProduct(id)
        list listProducts(name?, sku?, brand.id?) {
            @where(product.isEnabled)
            @sortable(
                name,
                sku,
                totalUnitsSold,
                stockAvailable,
                stockOnWay,
                estimatedMonthlySale,
                currentStockCover,
                totalStockCover
            )
            @orderBy(name: asc)
        }
        update updateProductDimensions(id) with (
            lengthInCm,
            widthInCm,
            heightInCm,
            weightInGrams,
        )
        update updateProduct(id) with (name?, brand.id?, sku?)
        update disableProduct(id) {
            @set(product.isEnabled = false)
        }
    }

    @permission(
        roles: [Operator],
        actions: [get, list, update, delete]
    )
}

flow SyncProducts {
    @permission(expression: ctx.isAuthenticated)
}

// Daily refresh of stock levels and cover. Pulls stock_on_hand from Zoho items
// and derives the trailing monthly sales estimate from local Sale history — a
// handful of Zoho calls, run off-peak to stay clear of the shared daily quota.
flow ScheduledSyncStock {
    @schedule("every day at 2am")
    @permission(roles: [Operator])
}

model EquipmentBox {
    fields {
        name Text
        sku Text?
        boxType BoxType
        image File?
        price Decimal @computed(equipmentBox.priceInclVat / 115 * 100)
        priceInclVat Decimal
        lengthInCm Decimal
        widthInCm Decimal
        heightInCm Decimal
        weightInGrams Decimal
        totalVolumeInLitres Decimal @computed(equipmentBox.lengthInCm * equipmentBox.widthInCm * equipmentBox.heightInCm / 1000)
        holdingVolumeInLitres Decimal @default(0.0)
        volumeUtilisationQuotient Decimal
        effectiveVolumeInLitres Decimal @computed(equipmentBox.holdingVolumeInLitres * equipmentBox.volumeUtilisationQuotient)
        isEnabled Boolean @default(true)
    }

    actions {
        get getEquipmentBox(id)
        create createEquipmentBox() with (
            name,
            sku,
            boxType,
            image?,
            priceInclVat,
            lengthInCm,
            widthInCm,
            heightInCm,
            weightInGrams,
            holdingVolumeInLitres,
            volumeUtilisationQuotient,
        )
        list listEquipmentBoxes()
        update updateEquipmentBoxImage(id) with (image)
        update updateEquipmentBox(id) with (
            name,
            sku,
            priceInclVat,
            lengthInCm,
            widthInCm,
            heightInCm,
            weightInGrams,
            holdingVolumeInLitres,
            volumeUtilisationQuotient,
        )
        update disableEquipmentBox(id) {
            @set(equipmentBox.isEnabled = false)
        }
    }

    @permission(
        roles: [Operator],
        actions: [get, create, list, update, delete]
    )
}

enum BoxType {
    Cardboard
    PlasticEquipment
}
