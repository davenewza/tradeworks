// A lightweight task list for the team. Deliberately not Keel's `task`
// construct: that is a queue of system-raised work with a fixed lifecycle
// (New, Assigned, Started, Completed, ...), whereas this is work people write
// down and move between statuses by hand.
enum TeamTaskStatus {
    Backlog
    InProgress
    Waiting
    Done
    // Out of the way for good: finished work, or work that will never be done,
    // that no longer needs to sit in the Done column. No task list shows it, so
    // an archived task is only reached through its own page.
    Archived
}

model TeamTask {
    fields {
        title Text
        description Markdown?
        status TeamTaskStatus @default(TeamTaskStatus.Backlog)
        // Unassigned tasks are normal, most of the backlog will be.
        assignee User?
        // When the task should be done by. Optional: most tasks won't have one.
        targetDate Date?
        // Who wrote the task down: the signed-in user when the task is created,
        // set by the create action and taken as input by nothing. Optional only
        // because tasks from before this was recorded have nobody on them.
        createdBy User?
        // When the task was last moved into Done, kept by the two actions that
        // can change a status (see lib/teamTaskHelpers.ts), and cleared again if
        // the task is moved back out of Done.
        completedAt Timestamp?
    }

    // How many tasks: the measure behind the hub's metric tiles.
    measures {
        tasks @computed(COUNT())
    }

    actions {
        get getTeamTask(id)
        // Every task bar the archived ones, which no list shows.
        list listTeamTasks(status?, assignee.id?) {
            @where(teamTask.status != TeamTaskStatus.Archived)
            @orderBy(createdAt: asc)
            @sortable(
                status,
                targetDate
            )
            @searchable(
                title,
                description
            )
        }
        // The hub's Mine tab: the signed-in person's tasks, otherwise as
        // listTeamTasks (archived ones left out too). Named to sort after
        // listTeamTasks: the Console wires a model's relation pickers to its
        // alphabetically first list tool.
        list listTeamTasksMine(status?) {
            @where(teamTask.assignee == ctx.identity.user && teamTask.status != TeamTaskStatus.Archived)
            @orderBy(createdAt: asc)
            @sortable(
                status,
                targetDate
            )
            @searchable(
                title,
                description
            )
        }
        // The hub's Overdue tab: open tasks whose target day has gone by. Due
        // today is not overdue yet, so days are compared rather than instants.
        list listTeamTasksOverdue(assignee.id?) {
            @where(BUCKET(teamTask.targetDate, day) < BUCKET(ctx.now, day) && teamTask.status != TeamTaskStatus.Done && teamTask.status != TeamTaskStatus.Archived)
            @orderBy(targetDate: asc)
            @sortable(
                status,
                targetDate
            )
            @searchable(
                title,
                description
            )
        }
        // The hub's metric tiles: how many of the signed-in person's tasks are
        // in each status. No grouping, so each call answers one number, and the
        // tile narrows it to a status through the action's own where input.
        aggregate countMyTeamTasks(status?) {
            @measures(tasks)
            @where(teamTask.assignee == ctx.identity.user)
        }
        // The "Mine overdue" tile: the signed-in person's share of the Overdue
        // tab, under the same rule as listTeamTasksOverdue.
        aggregate countMyOverdueTeamTasks() {
            @measures(tasks)
            @where(teamTask.assignee == ctx.identity.user && BUCKET(teamTask.targetDate, day) < BUCKET(ctx.now, day) && teamTask.status != TeamTaskStatus.Done && teamTask.status != TeamTaskStatus.Archived)
        }
        // Status is not asked for: every task starts in Backlog and is moved on from
        // there.
        create createTeamTask() with (title, description?, targetDate?, assignee.id?) {
            @set(teamTask.createdBy = ctx.identity.user)
        }
        // Only the words on the task. Status moves through moveTeamTask and the
        // assignee through assignTeamTask, so neither is changed by accident here.
        update updateTeamTask(id) with (title?, description?)
        // The Assign task button: sets who the task is for, or clears it by
        // leaving the assignee empty. It can change nothing else.
        update assignTeamTask(id) with (assignee.id?)
        // What the grid edits through. The Console grid ignores configuration and
        // edits via the model's update action with the most writable inputs, and
        // only those columns are editable. The narrow actions here each cover one
        // or two fields, so this wider one exists to make title, status, assignee
        // and target date editable in place. It has to stay the widest update
        // action, and the task page and list hide it from their own action lists.
        // A function because it can change the status, and so keeps completedAt.
        update editTeamTaskInline(id) with (
            title?,
            description?,
            status?,
            assignee.id?,
            targetDate?,
        ) @function
        // The Move button on a task: a one-field form for changing status without
        // opening the full edit form. It can change nothing but the status, and
        // keeps completedAt in step with it.
        update moveTeamTask(id) with (status) @function
        // The Archive task button: puts a task out of the way for good. One
        // click, nothing to fill in. completedAt is left as it was, so a
        // finished task keeps the time it was finished (see
        // lib/teamTaskHelpers.ts for the rule the status-changing actions share).
        update archiveTeamTask(id) {
            @set(teamTask.status = TeamTaskStatus.Archived)
        }
        delete deleteTeamTask(id)
    }

    @permission(
        roles: [Operator],
        actions: [get, list, aggregate, create, update, delete]
    )
}

// One-off: the Blocked status was renamed Waiting. Keel stores an enum as plain
// text and a rename migrates nothing, so tasks that were Blocked when the rename
// deployed still say Blocked until this has been run once. Running it again
// finds nothing to do.
flow MoveBlockedTasksToWaiting {
    @permission(roles: [Operator])
}

// The people a task can be given to: the Warehouse team. The Console's user
// pickers for a task (the Assign form, the grid's Assignee cell and the assignee
// filter) browse this list instead of every user, customers included. It only
// narrows what the pickers offer; the actions still accept any user id.
extend model User {
    actions {
        list listWarehouseUsers() {
            @where(Team.Warehouse in user.teams)
            @orderBy(name: asc)
            @searchable(
                name,
                email
            )
        }
    }
}
