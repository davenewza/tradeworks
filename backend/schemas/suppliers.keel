// The currencies supplier prices are quoted in. Overseas suppliers invoice in
// their own currency, so a price is only meaningful alongside its currency.
enum Currency {
    ZAR
    USD
    GBP
    EUR
    CNY
}

// Who we buy stock from: a vendor in Zoho Books, brought across by
// ImportSuppliers and linked to it by Zoho's contact id. Distinct from Brand:
// a brand is what's on the box, a supplier is who invoices us for it. They are
// often the same company, but a brand can come through a distributor, and one
// supplier can carry several brands. Purchase planning and stock-cover
// grading work off the supplier, since the lead time is theirs.
model Supplier {
    fields {
        // The vendor's contact_id in Zoho Books — the link back to it, so
        // bills and purchase orders there can be matched to this supplier.
        // Every supplier ImportSuppliers creates has one. Optional only for
        // suppliers made before suppliers came from Zoho: importing the vendor
        // of the same name links them.
        zohoVendorId Text? @unique
        // The vendor's name in Zoho, as it was when imported.
        name Text @unique
        // What the supplier normally invoices in — the vendor's currency in
        // Zoho, when it is one we support. Each price still carries its own.
        currency Currency @default(Currency.ZAR)
        // How long (in days) new stock takes to arrive from this supplier,
        // order to on-the-shelf — grades every product's stock-cover status
        // and is the default lead time when planning a purchase. Ours, not
        // Zoho's: set it after importing.
        leadTimeInDays Number @default(60)
        notes Text?
        priceLists SupplierPriceList[]
        bills SupplierBill[]
        purchaseOrders PurchaseOrder[]
        totalPriceLists Number @computed(COUNT(supplier.priceLists.id))
    }

    actions {
        get getSupplier(id)
        list listSuppliers() {
            @orderBy(name: asc)
        }
        // No create action: a supplier only comes from a Zoho vendor, via
        // ImportSuppliers.
        update updateSupplier(id) with (currency?, leadTimeInDays?, notes?)
        delete deleteSupplier(id)
    }

    @validate(supplier.leadTimeInDays > 0, "A supplier's lead time should be at least 1 day")

    @permission(
        roles: [Operator],
        actions: [get, list, update, delete]
    )
}

// Lists the active vendors in Zoho Books that aren't suppliers yet and creates
// a supplier for each one ticked, linked by its Zoho contact id. One paged
// read of the vendor list — a call or two against the shared Zoho quota.
flow ImportSuppliers {
    @permission(roles: [Operator])
}
