model PriceList {
    fields {
        name Text
        description Text?
        // The sales channel this price list is for. Its channel fees are what
        // apply to each product's pricing. Optional for migration safety, but it
        // should be set — with no channel, channel fees resolve to zero.
        channel Channel?
        // Target return on ad spend, as a ratio: 6 means we aim for R6 of sales
        // (incl VAT) for every R1 of advertising. Optional — leave it unset on
        // price lists we don't advertise on and their ad spend resolves to zero.
        targetAdvertisingRoi Decimal?
        numberOfProducts Number @computed(COUNT(priceList.products.id))
        products ProductPrice[]
        discounts DiscountTier[]
    }

    actions {
        get getPriceList(id)
        create createPriceList() with (name, description?, channel.id?, targetAdvertisingRoi?)
        list listPriceLists()
        update updatePriceList(id) with (name, description?, targetAdvertisingRoi?)
    }

    @on(
        [create, update],
        pricelistUpdate
    )

    @permission(
        expression: ctx.isAuthenticated,
        actions: [get, create, list, update, delete]
    )
}

model ProductPrice {
    fields {
        product Product
        productName Text @computed(productPrice.product.name)
        productSku Text @computed(productPrice.product.sku)
        priceList PriceList
        // The one entered value; everything below is derived from it plus the
        // product's synced costs/fees and the price list's channel.
        priceInclVat Decimal
        price Decimal @computed(productPrice.priceInclVat / 115 * 100)
        // The price list's channel name, hoisted to a direct field. Aggregate
        // filters can't reference a multi-hop root path, so the fee filters below
        // match this direct field against each fee's channelName. Channel names
        // are unique, so this is an exact channel match.
        priceListChannelName Text? @computed(productPrice.priceList.channel.name)
        // Price list name, hoisted for display (e.g. on the product page, which
        // lists a product's price across every price list). Optional so adding it
        // to a populated table is migration-safe; populated on next write.
        priceListName Text? @computed(productPrice.priceList.name)
        // The price list's target return on ad spend, hoisted for the ad spend
        // calculation below and so the view can show what drove it.
        targetAdvertisingRoi Decimal? @computed(productPrice.priceList.targetAdvertisingRoi)
        // Landed cost, split into cost of goods and freight-in (weighted averages
        // across the product's bills). landedUnitCost is their sum.
        unitCost Decimal? @computed(productPrice.product.weightedUnitCost)
        unitFreightIn Decimal? @computed(productPrice.product.weightedFreightIn)
        landedUnitCost Decimal? @computed(productPrice.product.weightedLandedCost)
        // Applicable channel fees for this product on the price list's channel.
        // A commission fee is a % of the incl-VAT price; a flat fee is a rand
        // amount. No matching fees → zero.
        successFeePercentage Decimal? @computed(SUMIF(productPrice.product.channelFees.feeValue, productPrice.product.channelFees.feeMethod == FeeMethod.Commission && productPrice.product.channelFees.channelName == productPrice.priceListChannelName))
        flatFeeTotal Decimal? @computed(SUMIF(productPrice.product.channelFees.feeValue, productPrice.product.channelFees.feeMethod == FeeMethod.Flat && productPrice.product.channelFees.channelName == productPrice.priceListChannelName))
        // Channel-wide fees applied to every product (no per-product assignment),
        // aggregated straight off the price list's channel.
        alwaysCommissionPercentage Decimal? @computed(SUMIF(productPrice.priceList.channel.fees.value, productPrice.priceList.channel.fees.alwaysApplied == true && productPrice.priceList.channel.fees.method == FeeMethod.Commission))
        alwaysFlatTotal Decimal? @computed(SUMIF(productPrice.priceList.channel.fees.value, productPrice.priceList.channel.fees.alwaysApplied == true && productPrice.priceList.channel.fees.method == FeeMethod.Flat))
        // Channel fees are charged VAT-inclusive, so strip VAT to get the real
        // (deductible) cost gross profit is measured against. Combines per-product
        // fees with the channel's always-applied fees.
        channelFees Decimal? @computed(((productPrice.flatFeeTotal + productPrice.alwaysFlatTotal) + (productPrice.successFeePercentage + productPrice.alwaysCommissionPercentage) / 100 * productPrice.priceInclVat) / 115 * 100)
        // Advertising cost per unit implied by the price list's target ROI. ROI is
        // measured on the incl-VAT sales price, so at a 6:1 target a R690 sale
        // carries R115 of ad spend. Ad spend is billed VAT-inclusive, so — as with
        // channel fees — strip VAT to get the deductible cost. No target → zero
        // (not null, which would NULL-poison totalCosts and gross profit on every
        // price list we don't advertise).
        adSpend Decimal? @computed(IF(productPrice.targetAdvertisingRoi > 0, productPrice.priceInclVat / productPrice.targetAdvertisingRoi / 115 * 100, 0))
        // Everything gross profit is measured against: cost of goods + freight-in
        // + channel fees + ad spend, all net of VAT.
        totalCosts Decimal? @computed(productPrice.landedUnitCost + productPrice.channelFees + productPrice.adSpend)
        grossProfit Decimal? @computed(productPrice.price - productPrice.totalCosts)
        // Stored as a 0–1 ratio; the Console formats it as a percentage (rounded
        // to a whole number). The engine has no ROUND function, so display-time
        // percent formatting is how we round.
        grossProfitMargin Decimal? @computed(IF(productPrice.price > 0, productPrice.grossProfit / productPrice.price, productPrice.grossProfit * 0))
    }

    actions {
        get getProductPrice(id) {
            @embed(product)
        }
        create createProductPrice() with (product.id, priceList.id, priceInclVat)
        list listProductPrices(
            priceList.id,
            productName?,
            productSku?,
            product.brand.id?,
        ) {
            @searchable(
                productName,
                productSku
            )
            @sortable(
                productName,
                productSku
            )
            @orderBy(productName: desc)
        }
        // A product's prices across every price list — embedded on the product page.
        list listProductPricesForProduct(product.id) {
            @orderBy(priceListName: asc)
        }
        update updateProductPrice(id) with (priceInclVat)
        delete deleteProductPrice(id)
    }

    @on(
        [create, update, delete],
        pricelistUpdate
    )

    @unique([product, priceList])

    @permission(
        expression: ctx.isAuthenticated,
        actions: [get, create, list, update, delete]
    )
}

model DiscountTier {
    fields {
        priceList PriceList
        discountPercentage Decimal
        minQuantity Number?
        maxQuantity Number?
    }

    actions {
        get getDiscountTier(id)
        create createDiscountTier() with (
            priceList.id,
            discountPercentage,
            minQuantity?,
            maxQuantity?,
        )
        list listDiscountTiers(priceList.id) {
            @orderBy(
                minQuantity: asc,
                maxQuantity: asc
            )
        }
        update updateDiscountTier(id) with (
            discountPercentage,
            minQuantity?,
            maxQuantity?,
        )
        delete deleteDiscountTier(id)
    }

    @permission(
        expression: ctx.isAuthenticated,
        actions: [get, create, list, update, delete]
    )
}

model PriceListChangeLog {
    fields {
        priceList PriceList
        description Text
        user User
    }

    actions {
        list listPriceListChangeLog(priceList.id) {
            @permission(expression: ctx.isAuthenticated)
        }
    }
}
