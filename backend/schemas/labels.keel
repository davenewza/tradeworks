// Unit barcode labels for stock going into a channel's fulfilment centre,
// printed on the warehouse Zebra as ZPL. See docs/channel-barcode-labels.md.
//
// Channels differ in every part of the label, so none of it is hardcoded:
//   - Takealot wants the product's EAN-13 with an "MP" marker stacked at the
//     left of the symbol, under the product name.
//   - Amazon FBA wants the FNSKU as Code 128 at the top, the product name
//     under it, and the item condition ("New") — which Amazon requires on
//     every unit label — at the very bottom.
// A channel is printable once it has a ChannelLabelSpec; what goes on the
// label, and in what order, is a list of ChannelLabelElement rows. Both are
// data, so a new channel or a new line of text is a row, not a code change.

enum BarcodeSymbology {
    // Fixed 95-module symbol, digits only, 13th digit a check digit. Used where
    // the channel prints the product's GTIN.
    Ean13
    // Variable-width (11 modules per character), full printable ASCII. Used for
    // channel-assigned codes like Amazon's FNSKU, which are alphanumeric and so
    // cannot be expressed as an EAN.
    Code128
}

// Roll sizes the warehouse stocks. Held as an enum rather than free-form
// millimetres so the Console offers a dropdown and the renderer's geometry table
// cannot drift from what is selectable.
enum LabelStockSize {
    Size40x25
    Size50x25
    // The roll the warehouse actually runs on, and the default for a new spec.
    Size50x30
    // 66.7 × 25.4 mm — 2⅝" × 1", the common Amazon FBA thermal size.
    Size67x25
    Size100x50
}

// What one line of a label is. Everything except StackedText is stacked down
// the label in `position` order, which is what lets the two shapes differ:
// Takealot runs Title then Barcode, Amazon runs Barcode then Title then the
// condition.
enum LabelElementKind {
    // The product name, wrapped and truncated to the space it is given.
    Title
    // The symbol, plus the human-readable interpretation line the printer
    // draws directly beneath the bars. Exactly one per spec — it is the label.
    // It takes whatever height the other elements leave.
    Barcode
    // A fixed line of text — Amazon's item condition.
    Text
    // Fixed text set one character per line down the left of the symbol —
    // Takealot's "MP". Out of the vertical flow, so `position` does not apply.
    StackedText
}

// How one channel's unit label is built. One row per channel we label for,
// with the label's contents hanging off it as ChannelLabelElement rows.
model ChannelLabelSpec {
    fields {
        channel Channel @unique
        symbology BarcodeSymbology
        // What is printed, and in what order. A spec with no elements still
        // prints — product name over the barcode, the shape every channel
        // shares — and the print flow says it is falling back to that, so a
        // half-configured channel is visible rather than silently plain.
        elements ChannelLabelElement[]
        // The roll this channel's labels are printed on. The print flow reads it
        // straight off the spec and never asks — the roll is a property of how
        // the channel is set up, not a per-run decision, and asking every time
        // invited a mis-click that would waste a run. Change it here when the
        // warehouse changes stock.
        defaultStock LabelStockSize @default(LabelStockSize.Size50x30)
        isEnabled Boolean @default(true)
    }

    actions {
        get getChannelLabelSpec(id)
        list listChannelLabelSpecs(channel.id?, isEnabled?) {
            @orderBy(createdAt: asc)
        }
        create createChannelLabelSpec() with (channel.id, symbology, defaultStock?)
        update updateChannelLabelSpec(id) with (symbology, defaultStock?, isEnabled?)
        delete deleteChannelLabelSpec(id)
    }

    @permission(
        roles: [Operator],
        actions: [get, list, create, update, delete]
    )
}

// One line of a channel's label.
//
// Deliberately rows rather than a fixed set of fields on the spec: the two
// shapes in use disagree about where the *product name* goes, not just about
// the fixed text, so no arrangement of named slots covers both. As rows, a new
// line of text — a condition, a batch note, a country of origin — is something
// the Console adds, and the renderer never learns another special case.
model ChannelLabelElement {
    fields {
        spec ChannelLabelSpec
        // Top-to-bottom order. Sparse and duplicable on purpose: no unique
        // constraint, so re-ordering two rows does not have to dodge one.
        // Ties break on creation order.
        position Number @default(1)
        kind LabelElementKind
        // Required for Text and StackedText; unused by Title and Barcode.
        text Text?
        // Title only: how many lines the product name may wrap to before it is
        // truncated. Two fits most names on the warehouse roll; one buys the
        // barcode about 2.7mm of extra height.
        maxLines Number @default(2)
    }

    actions {
        get getChannelLabelElement(id)
        list listChannelLabelElements(spec.id?) {
            @orderBy(position: asc)
        }
        create createChannelLabelElement() with (spec.id, kind, position?, text?, maxLines?)
        update updateChannelLabelElement(id) with (kind, position?, text?, maxLines?)
        delete deleteChannelLabelElement(id)
    }

    @permission(
        roles: [Operator],
        actions: [get, list, create, update, delete]
    )
}

// The code printed on a product's label for one channel: the EAN-13 Takealot
// holds against the offer, the FNSKU Amazon assigns, and so on.
//
// Deliberately one row per channel rather than a single code on Product. The
// codes are not interchangeable — an FNSKU is Amazon's own fulfilment
// identifier, meaningless anywhere else — so collapsing them onto the product
// would only work for the EAN case. The cost is that a product sold on two
// EAN-13 channels carries the same digits twice; that is explicit and visible,
// which beats a single field the flow has to guess the meaning of.
model ProductChannelCode {
    fields {
        product Product
        channel Channel
        code Text
        // Display copy so a product's codes read in one table without following
        // each lookup, matching how ProductChannelFee does it.
        channelName Text @computed(productChannelCode.channel.name)
    }

    actions {
        get getProductChannelCode(id)
        list listProductChannelCodes(product.id?, channel.id?) {
            @orderBy(channelName: asc)
        }
        create createProductChannelCode() with (product.id, channel.id, code)
        update updateProductChannelCode(id) with (code)
        delete deleteProductChannelCode(id)
    }

    // One code per product per channel.
    @unique([product, channel])

    @permission(
        roles: [Operator],
        actions: [get, list, create, update, delete]
    )
}

// Prints unit labels for a channel. Launched three ways:
//   - from the Products space with no input, picking products from a table;
//   - from a product page as an entry action, which passes productId and skips
//     straight to that product's label count;
//   - from a channel shipment as an entry action, which passes shipmentId: the
//     shipment fixes the channel and seeds a label count per line from the units
//     being sent, so a whole consignment is labelled in one run.
flow PrintChannelBarcodes {
    inputs {
        productId ID?
        shipmentId ID?
    }
    @permission(roles: [Operator])
}

// Pulls every offer from the Takealot Marketplace API and sets each matched
// product's Takealot channel code to the barcode held against the offer
// (matched by SKU). Bulk backfill and repair; day-to-day changes are handled
// by the syncTakealotBarcode subscriber on Product.
flow SyncTakealotBarcodes {
    @permission(roles: [Operator])
}

// Pulls every FBA listing from the Amazon Selling Partner API (FBA Inventory
// summaries) and sets each matched product's Amazon channel code to the
// listing's FNSKU (matched by seller SKU). Bulk backfill and repair, reviewed
// before apply, like the Takealot sync. There is no per-product subscriber:
// an FNSKU exists once the listing is created on Amazon, not when the product
// is created here, so a product-create hook would mostly find nothing yet.
flow SyncAmazonFnskus {
    @permission(roles: [Operator])
}
